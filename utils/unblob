log = logging.getLogger('unblob')


def parse_hex_int(value):
    """Parse an integer that may be in hex (0x...) or decimal format."""
    if value.startswith('0x') or value.startswith('0X'):
        return int(value, 16)
    return int(value)


class OverallPerformanceTracker:
    """Track overall performance for the unblob pipeline."""

    def __init__(self):
        self.start_time = time.time()
        self.stages = {}
        if HAS_PSUTIL:
            self.start_cpu = psutil.Process().cpu_times()

    def _get_mem_gb(self):
        """Get USS (Unique Set Size) memory in GB - most accurate for this process."""
        if not HAS_PSUTIL:
            return 0
        try:
            return psutil.Process().memory_full_info().uss / (1024**3)
        except (AttributeError, psutil.AccessDenied):
            return psutil.Process().memory_info().rss / (1024**3)

    def start_stage(self, name):
        """Start timing a stage."""
        mem_gb = self._get_mem_gb()
        self.stages[name] = {
            'start': time.time(),
            'end': None,
            'duration': None,
            'start_mem_gb': mem_gb,
        }
        log.info(f"[STAGE] {name} started | Mem: {mem_gb:.2f} GB")

    def end_stage(self, name, extra=""):
        """End timing a stage."""
        if name not in self.stages:
            return
        stage = self.stages[name]
        stage['end'] = time.time()
        stage['duration'] = stage['end'] - stage['start']
        mem_gb = self._get_mem_gb()
        stage['end_mem_gb'] = mem_gb
        log.info(f"[STAGE] {name} completed: {stage['duration']:.2f}s | Mem: {mem_gb:.2f} GB {extra}")

    def print_summary(self):
        """Print overall performance summary."""
        total_time = time.time() - self.start_time
        log.info("=" * 70)
        log.info("OVERALL PERFORMANCE SUMMARY")
        log.info("=" * 70)
        log.info(f"Total wall time: {total_time:.2f}s ({total_time/60:.2f} min)")

        if HAS_PSUTIL:
            cpu_times = psutil.Process().cpu_times()
            total_cpu = (cpu_times.user - self.start_cpu.user) + (cpu_times.system - self.start_cpu.system)
            log.info(f"Total CPU time: {total_cpu:.2f}s")
            log.info(f"CPU efficiency: {100*total_cpu/total_time:.1f}%")
            mem_gb = self._get_mem_gb()
            log.info(f"Final memory: {mem_gb:.2f} GB")

        log.info("-" * 70)
        log.info(f"{'Stage':<30} {'Duration':>12} {'Start Mem':>12} {'End Mem':>12}")
        log.info("-" * 70)
        for name, stage in self.stages.items():
            if stage['duration'] is not None:
                duration_str = f"{stage['duration']:.2f}s"
                start_mem = f"{stage.get('start_mem_gb', 0):.2f} GB"
                end_mem = f"{stage.get('end_mem_gb', 0):.2f} GB"
                log.info(f"{name:<30} {duration_str:>12} {start_mem:>12} {end_mem:>12}")
        log.info("=" * 70)

def parse_opts():
    parser = argparse.ArgumentParser()
    parser.add_argument("infile")
    parser.add_argument('outfile')
    parser.add_argument("--debug", action='store_true')

    modes = parser.add_mutually_exclusive_group()
    modes.add_argument("-U", dest='mode_normal', action='store_true', help='Unblobulate!')
    modes.add_argument("-X", dest='mode_extract', action='store_true', help='Extract')
    modes.add_argument("-B", dest='mode_build', action='store_true', help="Build library signatures (provide input directory and output LMDB filename)")

    parser.add_argument("-j", "--jobs", type=int, default=None, help="Number of parallel workers (default: auto-detect CPU count, max 16)")

    input_opts = parser.add_argument_group("Input options (override auto-detection)")
    input_opts.add_argument('--arch', metavar='ARCH',
                           help="Architecture (e.g., cortexm, arm, x86, amd64, mips, ppc, aarch64)")
    input_opts.add_argument('--base', type=parse_hex_int, metavar='0xADDR',
                           help="Base address (hex or decimal)")
    input_opts.add_argument('--entry', type=parse_hex_int, metavar='0xADDR',
                           help="Entry point (hex or decimal)")

    symbol_opts = parser.add_argument_group("Symbol Recovery Options")
    symbol_opts.add_argument("-S", "--disable-symbol-recovery", help="Enable symbol recovery", action='store_true')
    symbol_opts.add_argument('-F', "--fudge-factor", help="Lowest similarity score to consider a 'match' for symbol recovery")
    symbol_opts.add_argument('-L', "--lmdb", help="LMDB file to use for symbol recovery")
    symbol_opts.add_argument('-1', "--first-order", help="Only use the first-order metric to gather symbols", action='store_true')
    symbol_opts.add_argument('-2', "--second-order", help="Only use the third-order metric to gather symbols",
                           action='store_true')
    symbol_opts.add_argument('-3', "--third-order", help="Only use the third-order metric to gather symbols",
                       action='store_true')
    symbol_opts.add_argument('--scoring', help="Enable scoring mode, use a binary with symbols to score symbol recovery accuracy", action='store_true')

    output_opts = parser.add_argument_group('Output Options')
    output_opts.add_argument("-E", "--elf", help="Produce an ELF (Default)", action='store_true')
    output_opts.add_argument("-Y", "--yaml", help="Produce a YAML file", action='store_true')
    opts = parser.parse_args()


    if opts.mode_normal:
        if not opts.disable_symbol_recovery and not opts.lmdb:
            parser.error("To use symbol recovery, you must specify signatures to match with using -L (or disable symbol recovery)")
    elif opts.mode_extract:
        parser.error("Not implemented yet")
    return opts


def load_it(opts):
    """
    Load binary with optional manual overrides for arch, base address, and entry point.
    Falls back to autoblob for auto-detection if needed.
    """
    try:
        # If all parameters specified, use blob backend directly
        if opts.arch and opts.base is not None and opts.entry is not None:
            log.info(f"Loading with manual settings: arch={opts.arch}, base={opts.base:#x}, entry={opts.entry:#x}")
            p = angr.Project(opts.infile,
                             main_opts={'base_addr': opts.base,
                                        'arch': opts.arch,
                                        'backend': 'blob',
                                        'entry_point': opts.entry,
                                        'force_rebase': True})
            return p

        # Try standard loading first (for ELF, PE, etc.)
        try:
            p = angr.Project(opts.infile)
            log.info("Loaded using standard backend")
            return p
        except Exception as e:
            log.debug(f"Standard loading failed: {e}")

        # Fall back to autoblob for auto-detection
        log.info("Trying autoblob backend for auto-detection...")
        main_opts = {'backend': 'autoblob'}

        # Apply any manual overrides to autoblob
        if opts.arch:
            main_opts['arch'] = opts.arch
            log.info(f"Using manual arch override: {opts.arch}")
        if opts.base is not None:
            main_opts['base_addr'] = opts.base
            log.info(f"Using manual base address: {opts.base:#x}")
        if opts.entry is not None:
            main_opts['entry_point'] = opts.entry
            log.info(f"Using manual entry point: {opts.entry:#x}")

        p = angr.Project(opts.infile, main_opts=main_opts)
        return p
    except:
        log.exception("Error loading binary")
        return None


def make_yaml(project, symbol_map, opts):
    the_dict = {
        'architecture': opts.detected_arch.qemu_name,
        'base_address': opts.detected_base,
        'entry_point': opts.detected_entry,
        'symbols': symbol_map,
    }
    with open(opts.outfile, 'w') as f:
        yaml.dump(the_dict, stream=f)


def do_normal(opts):
    # Initialize performance tracker
    perf = OverallPerformanceTracker()

    # Load the binary (auto-detect or use manual overrides)
    perf.start_stage("Binary loading")
    project = load_it(opts)
    if not project:
        log.critical("Load failed!")
        sys.exit(1)
    # Store detected values for later use
    opts.detected_arch = project.arch
    opts.detected_base = project.loader.main_object.min_addr
    opts.detected_entry = project.entry
    perf.end_stage("Binary loading")

    log.info("################")
    log.info("Detected architecture: %s" % project.arch.name)
    log.info("Detected base address: %#08x" % project.loader.main_object.min_addr)
    log.info("Detected entry point: %#08x" % project.entry)

    # Now do symbol recovery
    symbol_map = None
    if not opts.disable_symbol_recovery:
        # Load LMDB
        perf.start_stage("LMDB loading")
        log.info("Loading LMDB from %s" % opts.lmdb)
        lmdb = LibMatchDatabase.load_path(opts.lmdb)
        # Release CFG memory from library LMDs (saves ~5-7GB per LMD)
        lmdb.release_all_cfgs()
        # Count library stats
        num_libs = len(lmdb.lib_lmds)
        num_objects = sum(len(lmds) for lmds in lmdb.lib_lmds.values())
        perf.end_stage("LMDB loading", f"| Libs: {num_libs}, Objects: {num_objects}")

        # Build target LMD
        perf.start_stage("Target CFG analysis")
        log.info("Processing target binary")
        lmd = LibMatchDescriptor(project)
        # Release CFG memory from target LMD after initialization
        lmd.release_cfg()
        num_funcs = len(lmd.viable_functions)
        perf.end_stage("Target CFG analysis", f"| Functions: {num_funcs:,}")

        # Symbol recovery
        perf.start_stage("Symbol recovery")
        log.info("Beginning symbol recovery")
        symbol_map = lmdb.match(lmd, score=opts.scoring, jobs=opts.jobs)
        perf.end_stage("Symbol recovery", f"| Matched: {len(symbol_map):,}")

    # Create the output
    perf.start_stage("Output generation")
    if opts.elf:
        make_elf(project, symbol_map, opts)
    elif opts.yaml:
        make_yaml(project, symbol_map, opts)
    perf.end_stage("Output generation")

    # Print final summary
    perf.print_summary()


def do_build(opts):
    libs_dir = opts.infile
    if not os.path.isdir(libs_dir):
        log.error("%s is not a directory" % libs_dir)
        sys.exit(1)
    output_path = opts.outfile
    jobs = opts.jobs if opts.jobs is not None else min(16, os.cpu_count() or 8)
    log.info(f"Building LMDB with -j{jobs}")
    LibMatchDatabase.build(libs_dir, output_path=output_path, jobs=jobs)

def stfu(thing):
    l = logging.getLogger(thing)
    l.setLevel(logging.CRITICAL)

if __name__ == '__main__':
    opts = parse_opts()

    # Set log level based on --debug flag
    log_level = logging.DEBUG if opts.debug else logging.INFO
    logging.basicConfig(level=log_level)
    log.setLevel(log_level)
    logging.getLogger("bdsig").setLevel(log_level)

    stfu('cle.elf')
    stfu('cle.loader')
    stfu('angr.analyses.cfg.cfg_fast')
    stfu('angr.state_plugins.symbolic_memory')
    stfu('angr.engines.successors')
    if opts.mode_normal:
        do_normal(opts)
    elif opts.mode_build:
        do_build(opts)
