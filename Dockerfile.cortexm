## -*- docker-image-name: "libmatch-cortexm" -*-
## Dockerfile with patched CLE for ARM Cortex-M support
FROM python:3.11-slim

LABEL maintainer="edg@cs.ucsb.edu"
LABEL description="LibMatch with ARM Cortex-M support patch"

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    libffi-dev \
    libssl-dev \
    libxml2-dev \
    libxslt1-dev \
    binutils-multiarch \
    vim \
    && rm -rf /var/lib/apt/lists/*

# Create working directory
WORKDIR /app

# Install autoblob (custom CLE loader)
RUN git clone https://github.com/subwire/autoblob /tmp/autoblob && \
    cd /tmp/autoblob && \
    pip install --no-cache-dir . && \
    cd / && rm -rf /tmp/autoblob

# Copy requirements first for better Docker layer caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# PATCH: Install patched CLE with Cortex-M detection fix
# The cloned repos are dev versions that depend on each other
# Install in order: archinfo, pyvex, then patched CLE

# Uninstall the versions that came with angr
RUN pip uninstall -y archinfo pyvex cle

# Copy and install all three packages from cloned repos
COPY angr_investigation/archinfo /tmp/archinfo
COPY angr_investigation/pyvex /tmp/pyvex
COPY angr_investigation/cle /tmp/cle

RUN cd /tmp/archinfo && pip install --no-cache-dir . && cd / && \
    cd /tmp/pyvex && pip install --no-cache-dir . && cd / && \
    cd /tmp/cle && pip install --no-cache-dir . && cd /

# Copy application code
COPY . .

# Install libmatch in development mode
RUN pip install --no-cache-dir -e .

# Set working directory
WORKDIR /app
